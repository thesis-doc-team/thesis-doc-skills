{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "毕业设计任务书填充数据（只作输入结构，不是课题范本）",
  "type": "object",
  "required": ["title", "thesis_content", "schedule", "references", "issuer_opinion"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "college": {"type": "string", "default": ""},
    "class_name": {"type": "string", "default": ""},
    "student_name": {"type": "string", "default": ""},
    "student_id": {"type": "string", "default": ""},
    "instructor_name": {"type": "string", "default": ""},
    "instructor_title": {"type": "string", "default": ""},
    "start_date": {"type": "string", "description": "YYYY-MM-DD；仅本轮资料有依据时填写"},
    "end_date": {"type": "string", "description": "YYYY-MM-DD；仅本轮资料有依据时填写"},
    "total_weeks": {"type": "integer", "minimum": 1},
    "thesis_content": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "schedule": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "required": ["from_week", "to_week", "task"],
        "properties": {"from_week": {"type": "integer", "minimum": 1}, "to_week": {"type": "integer", "minimum": 1}, "task": {"type": "string", "minLength": 1}},
        "additionalProperties": false}
    },
    "references": {
      "type": "array", "minItems": 10,
      "items": {"type": "object", "required": ["citation", "source_url", "source_type", "verified"],
        "properties": {
          "citation": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "minLength": 1},
          "source_type": {"type": "string", "enum": ["journal", "thesis", "conference", "book", "standard", "official-doc", "blog", "other"]},
          "verified": {"type": "boolean", "description": "须由实际检索/打开文献页得到，不可为凑数填写 true"},
          "checked_at": {"type": "string", "description": "实际核验日期 YYYY-MM-DD"}
        }, "additionalProperties": false}
    },
    "issuer_opinion": {"type": "string", "minLength": 50},
    "receiver_opinion": {"type": "string", "description": "默认留空，由用户决定是否填写"}
  },
  "additionalProperties": false
}
