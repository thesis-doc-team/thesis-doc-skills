{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "仅限毕业设计中期检查记录表的本轮草稿输入",
  "type": "object",
  "required": ["project_id", "title", "progress_paragraphs", "issues_paragraphs", "teacher_opinion_paragraphs", "teacher_opinion_is_draft"],
  "properties": {
    "project_id": {"type": "string"},
    "title": {"type": "string", "minLength": 1},
    "student_name": {"type": "string"},
    "class_name": {"type": "string"},
    "inspection_date": {"type": "string", "format": "date"},
    "progress_paragraphs": {"$ref": "#/$defs/textBlock"},
    "issues_paragraphs": {"$ref": "#/$defs/textBlock"},
    "teacher_opinion_paragraphs": {"$ref": "#/$defs/textBlock"},
    "teacher_opinion_is_draft": {"const": true},
    "college_opinion_paragraphs": {"$ref": "#/$defs/textBlock"},
    "college_opinion_authorized": {"type": "boolean", "default": false},
    "asset_reference_ids": {"type": "array", "items": {"type": "string", "pattern": "^REF-"}, "uniqueItems": true},
    "asset_fact_ids": {"type": "array", "items": {"type": "string", "pattern": "^FACT-"}, "uniqueItems": true},
    "asset_progress_ids": {"type": "array", "items": {"type": "string", "pattern": "^PROG-"}, "uniqueItems": true},
    "schedule_id": {"type": "string"},
    "evidence_notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "textBlock": {
      "oneOf": [
        {"type": "string", "minLength": 200},
        {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      ]
    }
  },
  "additionalProperties": true
}
