{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "thesis guidance record draft",
  "type": "object",
  "required": ["project_id", "title", "records"],
  "properties": {
    "project_id": {"type": "string"},
    "title": {"type": "string", "minLength": 3},
    "student_name": {"type": "string"},
    "student_id": {"type": "string"},
    "college": {"type": "string"},
    "major": {"type": "string"},
    "grade": {"type": "string"},
    "class_name": {"type": "string"},
    "advisor_name": {"type": "string"},
    "advisor_title": {"type": "string"},
    "asset_reference_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "asset_fact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "asset_progress_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "schedule_id": {"type": "string"},
    "records": {
      "type": "array", "minItems": 8, "maxItems": 60,
      "items": {
        "type": "object", "required": ["status", "issue_pairs"],
        "properties": {
          "status": {"const": "draft"},
          "date": {"type": "string"},
          "date_verified": {"type": "boolean"},
          "location": {"type": "string"},
          "location_verified": {"type": "boolean"},
          "topic": {"type": "string", "description": "草稿元数据（组织写作用），不写入 DOCX；成品看不到主题字样属预期"},
          "evidence_note": {"type": "string", "description": "草稿元数据（证据备注），不写入 DOCX"},
          "issue_pairs": {"type": "array", "minItems": 1, "maxItems": 4,
            "items": {"type": "object", "required": ["problem", "action"],
              "properties": {"problem": {"type": "string", "minLength": 5},
                             "action": {"type": "string", "minLength": 5},
                             "verification": {"type": "string", "description": "草稿元数据（写稿参考的验收判据），不写入 DOCX、不是表格栏目"}}}}
        }
      }
    }
  }
}
