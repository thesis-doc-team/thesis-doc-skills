{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "project-solution-write request",
  "type": "object",
  "required": [
    "project_title",
    "requirements"
  ],
  "properties": {
    "project_title": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "planning",
        "existing_design",
        "source_code",
        "single_document"
      ]
    },
    "output": {
      "type": "string",
      "enum": [
        "both",
        "introduction",
        "implementation"
      ]
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "assumed",
              "unknown"
            ]
          },
          "source": {
            "type": "string"
          },
          "acceptance": {
            "type": "string"
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "existing_hardware": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "project_root": {
      "type": "string"
    },
    "optimization": {
      "type": "object",
      "description": "设计侧重；未提供时Agent先提供一次四选项，用户拒绝/要求直接生成时 balanced/proposed",
      "properties": {
        "priority": {
          "type": "string",
          "enum": [
            "cost",
            "performance",
            "function",
            "balanced"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "proposed"
          ]
        },
        "source": {
          "type": "string"
        },
        "budget_cap": {
          "type": "number",
          "minimum": 0
        },
        "budget_currency": {
          "type": "string"
        },
        "performance_targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "functional_focus": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "custom_weights": {
          "type": "object",
          "properties": {
            "cost": {
              "type": "number",
              "minimum": 0
            },
            "performance": {
              "type": "number",
              "minimum": 0
            },
            "function": {
              "type": "number",
              "minimum": 0
            },
            "complexity": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "secondary_priority": {
          "type": "string",
          "enum": [
            "cost",
            "performance",
            "function",
            "balanced"
          ],
          "description": "可选的次要裁决方向，用户未说就不要追问；不能覆盖主目标及硬约束"
        },
        "priority_reason": {
          "type": "string",
          "description": "用户实际意图或Agent对该项目优化目标的解释，须标状态来源"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
