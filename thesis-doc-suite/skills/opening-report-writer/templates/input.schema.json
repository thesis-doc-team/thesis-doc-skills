{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opening Report Draft Input (runtime-only)",
  "type": "object",
  "required": ["cover", "sections", "references", "teacher_opinion"],
  "properties": {
    "teacher_opinion": {
      "type": "string", "minLength": 50,
      "description": "指导教师审阅意见拟稿（不少于50字）：供教师审定，签名与日期保持留空；写法见 SKILL.md 教师意见拟稿统一规范"
    },
    "cover": {
      "type": "object",
      "description": "缺失封面个人信息保留官方留白，不得从匿名范本推断",
      "properties": {
        "title": {"type": "string"},
        "student_name": {"type": "string"},
        "student_id": {"type": "string"},
        "college": {"type": "string"},
        "major": {"type": "string"},
        "class_name": {"type": "string"},
        "supervisor": {"type": "string"},
        "supervisor_title": {"type": "string"},
        "date_range": {"type": "string"}
      },
      "additionalProperties": false
    },
    "allow_custom_heading_titles": {"type": "boolean", "default": false},
    "sections": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "items": {
        "type": "object", "required": ["id", "title"],
        "properties": {
          "id": {"type": "integer", "minimum": 1, "maximum": 7},
          "title": {"type": "string", "minLength": 2},
          "blocks": {"type": "array", "items": {
            "type": "object", "required": ["type"],
            "properties": {
              "type": {"enum": ["paragraph", "heading2", "heading3", "schedule"]},
              "text": {"type": "string"},
              "items": {"type": "array", "items": {
                "type": "object", "required": ["start_week", "end_week", "task"],
                "properties": {
                  "start_week": {"type": "integer", "minimum": 1},
                  "end_week": {"type": "integer", "minimum": 1},
                  "task": {"type": "string"}
                }
              }}
            }
          }}
        }
      }
    },
    "references": {
      "type": "array", "minItems": 10,
      "description": "所有条目必须经外部真实核验；json-schema不能代替文献查证",
      "items": {
        "type": "object",
        "required": ["text", "verified", "source_type"],
        "properties": {
          "text": {"type": "string", "minLength": 12, "description": "不含[n]编号；脚本只添加一次"},
          "source_type": {"enum": ["journal", "conference", "thesis", "standard", "official_doc", "book", "blog"]},
          "verified": {"const": true},
          "source_url": {"type": "string", "format": "uri"},
          "doi": {"type": "string"},
          "checked_at": {"type": "string"}
        },
        "anyOf": [{"required": ["source_url"]}, {"required": ["doi"]}]
      }
    }
  }
}
